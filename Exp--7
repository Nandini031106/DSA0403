import pandas as pd

# Create DataFrame
order_data = pd.DataFrame({
    "Customer_ID": [101, 102, 101, 103, 102],
    "Order_Date": ["2024-01-10", "2024-01-15", "2024-02-01", "2024-01-20", "2024-02-10"],
    "Product_Name": ["Laptop", "Mouse", "Laptop", "Keyboard", "Mouse"],
    "Order_Quantity": [2, 5, 1, 3, 4]
})

# 1. Total number of orders made by each customer
total_orders = order_data.groupby("Customer_ID")["Customer_ID"].count()

# 2. Average order quantity for each product
average_quantity = order_data.groupby("Product_Name")["Order_Quantity"].mean()

# 3. Earliest and latest order dates
earliest_date = order_data["Order_Date"].min()
latest_date = order_data["Order_Date"].max()

print("Total Orders:\n", total_orders)
print("\nAverage Order Quantity:\n", average_quantity)
print("\nEarliest Order Date:", earliest_date)
print("Latest Order Date:", latest_date)
