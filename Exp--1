import numpy as np

# 4x4 matrix (Rows = Students, Columns = Subjects)
student_scores = np.array([
    [85, 78, 90, 82],
    [88, 80, 84, 81],
    [79, 85, 86, 83],
    [81, 78, 83, 83]
])

# Subject names
subjects = ["Math", "Science", "English", "History"]

# Calculate average of each subject (column-wise)
average_scores = np.mean(student_scores, axis=0)

# Find subject with highest average
highest_subject = subjects[np.argmax(average_scores)]

# Display output
print("Average scores:", average_scores)
print("Subject with highest average:", highest_subject)
