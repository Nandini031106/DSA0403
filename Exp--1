import pandas as pd
from google.colab import files

# Upload dataset
uploaded = files.upload()

# Read Excel file
filename = list(uploaded.keys())[0]
student_scores = pd.read_excel(filename)

# Display dataset
print("Student Dataset:")
display(student_scores)

# Select subject columns
subjects = ['Math', 'English', 'Science', 'History', 'Geography']

# Calculate average marks for each subject
average_scores = student_scores[subjects].mean()

print("\nAverage score for each subject:")
print(average_scores)

# Find subject with highest average
highest_subject = average_scores.idxmax()
highest_average = average_scores.max()

print("\nSubject with highest average score:", highest_subject)
print("Highest average score:", highest_average)
