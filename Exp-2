# Import libraries
import pandas as pd
from google.colab import files

# Upload dataset
uploaded = files.upload()

# Read Excel file
filename = list(uploaded.keys())[0]
sales_data = pd.read_excel(filename)

# Display dataset
print("Sales Dataset:")
display(sales_data.head())

# Calculate average price
average_price = sales_data['Price'].mean()

print("\nAverage price of products sold:")
print(average_price)
